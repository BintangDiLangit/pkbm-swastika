# Template untuk environment variables
# Copy file ini ke .env.local dan isi dengan nilai asli dari Sheet.best dan EmailJS

# Sheet.best URL (dapatkan dari dashboard Sheet.best setelah menghubungkan Google Sheet)
# Contoh: https://sheet.best/api/sheets/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_SHEET_BEST_URL=https://api.sheetbest.com/sheets/1f29dc87-736f-4e50-b00a-0a80c0b6146e

# EmailJS credentials (dapatkan dari dashboard EmailJS)
# Service ID: ID layanan email yang Anda buat di EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id

# Template ID: ID template email untuk konfirmasi pendaftaran
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id

# Public Key: Kunci publik dari akun EmailJS Anda
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key
