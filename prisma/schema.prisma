// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Berita {
  id        String   @id @default(uuid())
  title     String
  excerpt   String?  @db.Text
  content   String   @db.Text
  author    String?
  category  String?
  image     String?
  date      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("berita")
}

model Galeri {
  id        String   @id @default(uuid())
  title     String
  category  String?
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("galeri")
}

model Pendaftaran {
  id                 String   @id @default(uuid())
  nama               String   @db.VarChar(100)
  email              String   @db.VarChar(100)
  telepon            String   @db.VarChar(20)
  paket              String   @db.VarChar(50)
  alamat             String   @db.Text
  tanggalLahir       DateTime
  pendidikanTerakhir String?  @db.VarChar(50)
  pekerjaan          String?  @db.VarChar(100)
  motivasi           String?  @db.Text
  status             String   @default("Menunggu") @db.VarChar(50)
  catatanAdmin       String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("pendaftaran")
}
