# Salin ke .env.local lalu isi nilainya.

# Wajib — koneksi PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ppdb?schema=public"

# Wajib saat menjalankan `npm run db:seed` — password akun admin awal
SEED_ADMIN_PASSWORD=

# Opsional — kirim salinan pendaftaran ke Google Sheets (sheet.best)
NEXT_PUBLIC_SHEET_BEST_URL=

# Opsional — email notifikasi pendaftaran via EmailJS
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
